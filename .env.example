# Ejemplo — backoffice-api. Solo lo relativo al licenciamiento;
# el resto de variables están en el .env real.

# LICENSING_SERVER_URL vacío = modo offline (solo valida license.key local).
# En producción (NODE_ENV=production), si queda vacío se usa
# https://licencias-api.prismapos.site por defecto.
LICENSING_SERVER_URL=https://licencias-api.prismapos.site
LICENSING_CLIENT_CODE=CLIENTE
STORE_NAME=Tienda
STORE_ID=001
POS_NO=1
LICENSING_POLL_MS=10000
LICENSING_ENROLL_MAX_ATTEMPTS=0
