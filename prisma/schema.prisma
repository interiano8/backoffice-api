generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BoSale {
  id                String        @id @default(uuid())
  source            String
  externalId        String
  saleIdFusion      String?
  timestamp         DateTime      @db.Timestamptz(6)
  shiftNo           String?
  shiftDate         DateTime?     @db.Date
  amount            Decimal       @db.Decimal(18, 4)
  volume            Decimal?      @db.Decimal(18, 4)
  unitPrice         Decimal?      @db.Decimal(18, 4)
  productName       String?
  unitOfMeasure     String?
  pumpId            String?
  hoseId            String?
  tankId            String?
  attendantName     String?
  customerId        String?
  customerName      String?
  billingType       String?
  paymentType       String?
  isReconciled      Boolean       @default(false)
  storeCode         String
  lineNo            Int           @default(0)
  discount          Decimal?      @db.Decimal(18, 4)
  reconcilerShiftId String?
  saleHeaderId      String?
  appliedDocNo      String?
  discountPct       Decimal?      @db.Decimal(18, 4)
  docType           Int?
  fsAmount          Decimal?      @db.Decimal(18, 4)
  fsFinalVolume     Decimal?      @db.Decimal(18, 4)
  fsInitialVolume   Decimal?      @db.Decimal(18, 4)
  fsPPU             Decimal?      @db.Decimal(18, 4)
  fsShiftId         String?
  fsVolume          Decimal?      @db.Decimal(18, 4)
  saleHeader        BoSaleHeader? @relation(fields: [saleHeaderId], references: [id])

  @@unique([source, storeCode, externalId, lineNo])
  @@index([timestamp])
  @@index([attendantName])
  @@index([shiftNo])
  @@index([saleIdFusion])
  @@index([storeCode])
  @@index([reconcilerShiftId])
  @@index([saleHeaderId])
}

model BoShift {
  id                  String    @id @default(uuid())
  source              String    @default("TPV")
  storeCode           String
  shiftDate           DateTime  @db.Date
  shiftNo             String
  employeeName        String
  startTime           DateTime  @db.Timestamptz(6)
  endTime             DateTime? @db.Timestamptz(6)
  status              String    @default("OPEN")
  totalSale           Decimal   @default(0) @db.Decimal(18, 4)
  totalDiscount       Decimal   @default(0) @db.Decimal(18, 4)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
  posCodes            String?   @map("pos_codes")
  reconcilerShiftId   String?   @map("reconciler_shift_id")
  creditNoteCount     Int       @default(0)
  invoiceCashCount    Int       @default(0)
  invoiceCreditCount  Int       @default(0)
  outflowCount        Int       @default(0)
  fsShiftIds          String?   @map("fs_shift_ids")
  cardDeclared        Decimal?  @db.Decimal(18, 4)
  cashDeclared        Decimal?  @db.Decimal(18, 4)
  isBalanced          Boolean   @default(false)
  isPresented         Boolean   @default(false)
  otherDeclared       Decimal?  @db.Decimal(18, 4)
  presentationDate    DateTime? @db.Timestamptz(6)
  presentationDetails String?   @db.Text
  presentationComment String?   @db.Text
  auditStatus         String    @default("PENDING")
  auditedBy           String?
  auditNotes          String?   @db.Text
  auditedAt           DateTime? @db.Timestamptz(6)
  cashVariance        Decimal?  @db.Decimal(18, 4)
  fuelVariance        Decimal?  @db.Decimal(18, 4)
  isLocked            Boolean   @default(false)

  @@unique([source, storeCode, shiftDate, shiftNo, employeeName])
  @@index([shiftDate])
  @@index([employeeName])
  @@index([storeCode])
  @@index([auditStatus])
}

model BoStore {
  id                     String    @id @default(uuid())
  code                   String    @unique
  name                   String
  address                String?
  ip                     String
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(6)
  RTN                    String?
  titulo                 String?
  apiUrl                 String?
  lanUrl                 String?
  showDetailsInStatement Boolean   @default(true)
  logoUrl                String?
  frontendUrl            String?
  isLocalStore           Boolean   @default(false)
  moduleCustomers        Int?      @default(1)
  printCreditInvoices    Boolean   @default(false)
  SyncMinutes            Int?      @default(300)
  PresentationMinutes    Int?      @default(30)
  dbPort                 Int?      @default(5432)
  dbName                 String?   @default("prisma")
  dbUser                 String?
  dbPassword             String?
  dbSsl                  Boolean?  @default(false)
  lastSeenAt             DateTime? @db.Timestamptz(6)
  latencyMs              Int?
  healthStatus           String?   @default("ONLINE")
  lastSyncAt             DateTime? @db.Timestamptz(6)
  lastSyncStatus         String?
  lastSyncError          String?   @db.Text

  // Wayne Fusion / Hardware
  ipFusion               String?
  urlControlador         String?
  claveControlador       String?
  esControladorGas       Boolean?  @default(false)

  // Parametros generales adicionales
  emisor                 String?
  moneda                 String?   @default("HNL")
  codigoMoneda           String?   @default("HNL")
  telefono               String?
  correo                 String?

  // Configuracion POS (espejo de configuracion_pos del POS local)
  posConfig              Json?

  // Versionado monótono para bootstrap y sync downstream
  configVersion          Int       @default(1)
  configUpdatedAt        DateTime  @default(now()) @db.Timestamptz(6)
}

model BoPaymentMethod {
  id                String       @id @default(uuid())
  source            String       @default("TPV")
  storeCode         String
  transactionId     String
  chargeLineNo      Int
  shiftDate         DateTime     @db.Date
  shiftNo           String
  employeeName      String
  chargeMethodCode  String
  description       String
  amount            Decimal      @db.Decimal(18, 4)
  paymentCardNo     String?
  additionalData    String?
  reconcilerShiftId String?
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)
  esTicket          Boolean      @default(false)
  saleHeader        BoSaleHeader @relation(fields: [source, storeCode, transactionId], references: [source, storeCode, transactionId], onUpdate: NoAction)

  @@unique([source, storeCode, transactionId, chargeLineNo])
  @@index([storeCode])
  @@index([shiftDate])
  @@index([shiftNo])
  @@index([employeeName])
  @@index([reconcilerShiftId])
}

model BoReconciliation {
  id            String    @id @default(uuid())
  type          String
  shiftNo       String?
  shiftDate     DateTime? @db.Date
  attendantName String?
  pumpId        String?
  status        String
  difference    Decimal?  @db.Decimal(18, 4)
  signedBy      String?
  signedAt      DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
}

model BoHose {
  id             String   @id @default(uuid())
  storeCode      String
  pumpId         Int
  hoseId         Int
  gradeId        Int
  gradeName      String
  unitPrice      Decimal? @db.Decimal(18, 4)
  tankId         String?
  hosePhysicalId Int?
  posCode        String?
  genericCode    String?
  unitOfMeasure  String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@unique([storeCode, pumpId, hoseId])
  @@index([storeCode])
}

model BoSaleHeader {
  id                String            @id @default(uuid())
  source            String            @default("TPV")
  storeCode         String
  transactionId     String
  docType           Int
  docNo             String
  shiftDate         DateTime          @db.Date
  shiftNo           String
  employeeName      String
  customerNo        String?
  customerName      String?
  rtn               String?
  subTotal          Decimal           @db.Decimal(18, 4)
  totalAmount       Decimal           @db.Decimal(18, 4)
  km                String?
  orden             String?
  placa             String?
  chofer            String?
  reconcilerShiftId String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)
  appliedDocNo      String?
  payments          BoPaymentMethod[]
  lines             BoSale[]

  @@unique([source, storeCode, transactionId])
  @@index([shiftDate])
  @@index([shiftNo])
  @@index([storeCode])
  @@index([reconcilerShiftId])
  @@index([docType])
}

model TankMeasurement {
  id          String   @id @default(uuid())
  storeCode   String
  shiftDate   DateTime @db.Date
  shiftNo     String
  tankId      String
  measureType String
  height      Decimal  @db.Decimal(10, 2)
  volume      Decimal  @db.Decimal(10, 2)
  waterLevel  Decimal? @db.Decimal(10, 2)
  temperature Decimal? @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@index([shiftDate])
  @@index([storeCode])
}

model BoPrintedReport {
  id               String   @id @default(uuid())
  storeCode        String
  shiftDate        DateTime @db.Date
  shiftNo          String
  employeeName     String
  printedBy        String
  printedAt        DateTime @default(now()) @db.Timestamptz(6)
  stationName      String
  version          Int      @default(1)
  dataSnapshot     String?  @db.Text
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@index([storeCode])
  @@index([shiftDate])
  @@index([shiftNo])
}

model BoSyncLock {
  lockKey   String   @id
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  email     String?
  role      String   @default("OPERATOR")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  userRoles UserRole[]

  @@index([username])
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  storeCode String?
  userId    String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([entity])
  @@index([entityId])
}

model Role {
  id          String           @id
  name        String
  description String?
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id
  name        String
  module      String
  description String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String
  roleId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model BoAlertConfig {
  id                      String   @id @default(uuid())
  recipientEmails         String   @db.Text
  cashVarianceThreshold   Decimal  @default(50.0) @db.Decimal(18, 4)
  alertsEnabled           Boolean  @default(true)
  shiftDiscrepancyEnabled Boolean  @default(true)
  fiscalGapEnabled        Boolean  @default(true)
  offlineStoreEnabled     Boolean  @default(true)
  offlineMinutesThreshold Int      @default(15)
  cooldownMinutes         Int      @default(60)
  createdAt               DateTime @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @db.Timestamptz(6)
}

// ==========================================
// MÓDULO DE CONTABILIDAD
// ==========================================

model Account {
  id              String             @id @default(uuid())
  code            String             @unique
  name            String
  type            String             // ASSET, LIABILITY, EQUITY, REVENUE, COST, EXPENSE
  nature          String             // DEBIT, CREDIT
  level           Int                @default(1)
  parentId        String?
  parent          Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[]          @relation("AccountHierarchy")
  allowsMovement  Boolean            @default(true)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)

  journalLines    JournalEntryLine[]
  mappings        AccountingMapping[]

  @@index([code])
  @@index([type])
  @@map("accounts")
}

model CostCenter {
  id              String             @id @default(uuid())
  code            String             @unique
  name            String
  storeCode       String?            // Enlace con BoStore.code
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)

  journalLines    JournalEntryLine[]
  mappings        AccountingMapping[]

  @@index([code])
  @@index([storeCode])
  @@map("cost_centers")
}

model FiscalPeriod {
  id              String         @id @default(uuid())
  year            Int
  month           Int            // 1 al 12
  status          String         @default("OPEN") // OPEN, CLOSED
  closedAt        DateTime?      @db.Timestamptz(6)
  closedBy        String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  journalEntries  JournalEntry[]

  @@unique([year, month])
  @@map("fiscal_periods")
}

model AccountingMapping {
  id               String       @id @default(uuid())
  category         String       // PAYMENT_METHOD, FUEL_PRODUCT, STORE_PRODUCT, TAX_ISV, CASH_SHORTAGE, CASH_SURPLUS, CUSTOMER_CREDIT
  sourceIdentifier String       // e.g. "CASH", "CARD", "CREDIT", gradeId "1", "ISV15"
  accountId        String
  account          Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  costCenterId     String?
  costCenter       CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(6)

  @@index([category, sourceIdentifier])
  @@index([costCenterId])
  @@map("accounting_mappings")
}

model JournalEntry {
  id              String             @id @default(uuid())
  entryNumber     Int                @default(autoincrement())
  date            DateTime           @db.Date
  type            String             @default("DIARY") // DIARY, INCOME, EXPENSE, REVERSAL
  concept         String             @db.Text
  status          String             @default("DRAFT") // DRAFT, POSTED, VOIDED
  sourceRef       String?            // e.g. "shift:uuid" or "receipt:uuid"
  totalDebit      Decimal            @default(0) @db.Decimal(18, 4)
  totalCredit     Decimal            @default(0) @db.Decimal(18, 4)
  notes           String?            @db.Text
  fiscalPeriodId  String?
  fiscalPeriod    FiscalPeriod?      @relation(fields: [fiscalPeriodId], references: [id])
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?          @db.Timestamptz(6)
  reversedById    String?
  reversedAt      DateTime?          @db.Timestamptz(6)
  reversalEntryId String?
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)

  lines           JournalEntryLine[]

  @@index([date])
  @@index([status])
  @@index([sourceRef])
  @@index([entryNumber])
  @@map("journal_entries")
}

model JournalEntryLine {
  id              String        @id @default(uuid())
  entryId         String
  entry           JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account       @relation(fields: [accountId], references: [id])
  costCenterId    String?
  costCenter      CostCenter?   @relation(fields: [costCenterId], references: [id])
  debit           Decimal       @default(0) @db.Decimal(18, 4)
  credit          Decimal       @default(0) @db.Decimal(18, 4)
  description     String?       @db.Text
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)

  @@index([entryId])
  @@index([accountId])
  @@index([costCenterId])
  @@map("journal_entry_lines")
}
